# Copiare questo file in .env solo per personalizzare i valori locali.
POSTGRES_DB=liveauction
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

PRODUCER_PORT=8081
CONSUMER_PORT=8082

# Solo per prove HTTP su LAN/VPN: false. Con HTTPS mantenere true.
CONSUMER_SESSION_COOKIE_SECURE=true

# Per prove LAN/VPN sostituire localhost con l'IP raggiungibile del server.
LIVEAUCTION_PRODUCER_WS_URL=ws://localhost:8081/ws
# Origini esatte separate da virgole; mantenere localhost per i browser locali.
LIVEAUCTION_WS_ALLOWED_ORIGINS=http://localhost:8082

# ID di un ADMIN attivo destinatario degli acquisti fissi. Con 0 e DEMO_SEED=true il
# Producer usa l'ADMIN demo `matteo`; con 0 e DEMO_SEED=false gli acquisti sono disabilitati.
SHOP_ADMIN_ID=0

# Dati demo all'avvio del Producer (idempotenti, creano solo ciò che manca):
# utenti matteo (ADMIN), andrea, maikol, cristian, marco, tommi (USER) con 5000 CRD,
# catalogo con immagini da DummyJSON (ripiego statico offline) e 3-4 aste programmate.
# Password comune: Demo2026! (cambiabile con DEMO_PASSWORD, solo alla prima creazione).
# Nel compose vale true se non impostata; fuori dal compose il default è false.
DEMO_SEED=true

# Per il profilo prod: impostare una stringa casuale di almeno 32 byte.
AUTH_JWT_SECRET=

# Opzionali, ad esempio: -Xms128m -Xmx512m
PRODUCER_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
CONSUMER_JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# Email: disabilitate fino alla configurazione del server scelto dal team.
# Non committare .env o credenziali reali. L'IDE non carica .env automaticamente:
# impostare queste variabili anche nella run configuration del Producer.
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_RETRY_SECONDS=60
EMAIL_BATCH_SIZE=20
EMAIL_INTERVAL_MS=30000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
# Per TLS implicito (tipicamente porta 465): SSL=true e STARTTLS/REQUIRED=false.
SMTP_SSL=false
