# Copiare questo file in .env solo per personalizzare i valori locali.
POSTGRES_DB=liveauction
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

PRODUCER_PORT=8081
CONSUMER_PORT=8082

# Per il profilo prod: impostare una stringa casuale di almeno 32 byte.
AUTH_JWT_SECRET=

# Opzionali, ad esempio: -Xms128m -Xmx512m
PRODUCER_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
CONSUMER_JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# Email: disabilitate fino alla configurazione del server scelto dal team.
# Non committare .env o credenziali reali. L'IDE non carica .env automaticamente:
# impostare queste variabili anche nella run configuration del Producer.
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_RETRY_SECONDS=60
EMAIL_BATCH_SIZE=20
EMAIL_INTERVAL_MS=30000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
# Per TLS implicito (tipicamente porta 465): SSL=true e STARTTLS/REQUIRED=false.
SMTP_SSL=false
